# Build output -- all generated by Ninja/VS64
build/*
!build/*.prg

# Visual Studio solution cache
.vs/

# Generated task binaries (build-tasks.ps1 output)
tasks-out/

# Scratch: captured build logs, byte-verifier dumps and one-off conversion
# scratch (frame extractions, comparison sheets). Everything here is
# regenerated on demand, so nothing in temp/ is worth committing -- including
# the downloaded source video and its extracted frames for a REU animation
# film (the recipe is in docs/pic-format.md).
/temp/

# KickAssembler/VS64 generated symbol maps and build info
*.sym
src/build/

# Python: the local virtualenv and caches
.venv/
__pycache__/

# Tool paths are machine-specific, so this one file is per-clone: copy
# .vscode/settings.json.sample (tracked) and edit the four vs64.* paths.
# Every build/launch script reads it through tools/toolpaths.ps1.
.vscode/settings.json

# tools/scan-history.py writes one report per Rule-14 category plus a summary.
# They are a lint read-out, regenerated on every run, never committed.
tools/hist_*.txt
